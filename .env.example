# Copy to .env and adjust for your environment. CRA only exposes vars prefixed REACT_APP_.

# Base URL of the blog REST API (json-server in development).
REACT_APP_API_URL=http://localhost:8000/

# Cloudinary unsigned upload settings (image uploads go directly from the browser).
REACT_APP_CLOUDINARY_CLOUD_NAME=dvnwx89ao
REACT_APP_CLOUDINARY_UPLOAD_PRESET=cg4zfcut
