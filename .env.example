# Copy to .env and adjust for your environment. CRA only exposes vars prefixed REACT_APP_.

# Base URL of the blog REST API (json-server in development).
REACT_APP_API_URL=http://localhost:8000/

# Cloudinary unsigned upload settings (image uploads go directly from the browser).
REACT_APP_CLOUDINARY_CLOUD_NAME=dvnwx89ao
REACT_APP_CLOUDINARY_UPLOAD_PRESET=cg4zfcut

# Optional: enables the AI "Cook From Your Pantry" recipe generator.
# WARNING: this key ships in the browser bundle (demo only). For production,
# proxy Anthropic calls through a backend so the key is never exposed.
# Leave unset to disable AI generation (the pantry matcher still works).
REACT_APP_ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8; e.g. claude-haiku-4-5 for cheaper/faster).
REACT_APP_ANTHROPIC_MODEL=claude-opus-4-8
