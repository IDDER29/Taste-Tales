# Copy to .env.local and adjust for your environment.
# In Next.js, only variables prefixed NEXT_PUBLIC_ are exposed to the browser.

# Base URL of the blog REST API (json-server in development; the frontend still
# uses this until it is rewired to the new /api routes).
NEXT_PUBLIC_API_URL=http://localhost:8000/

# ---- New backend (Prisma + Auth.js) — see docs/BACKEND.md ----
# Postgres connection strings (e.g. from Neon).
# DATABASE_URL = POOLED connection (PgBouncer) used by the app at runtime. On Neon
# this is the "-pooler" host; the pgbouncer flag + small connection_limit keep
# serverless functions from exhausting Postgres connections.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL = DIRECT (non-pooled) connection used by `prisma migrate`/`generate`.
# On Neon this is the same host WITHOUT "-pooler" and without the pgbouncer flag.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# Secret used to sign Auth.js (NextAuth) JWT sessions.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# ---- Cloudinary (image uploads) ----
# Cloud name is public. With API key + secret set, the app uses SIGNED uploads
# (secret stays server-side via /api/v1/uploads/sign). Without them it falls back
# to the unsigned preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dvnwx89ao
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Legacy unsigned upload preset (fallback when signing isn't configured).
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=cg4zfcut

# ---- AI ("Cook From Your Pantry" generator) ----
# The Anthropic key is SERVER-ONLY (used by /api/v1/ai/recipes/generate); it is
# never shipped to the browser. Set NEXT_PUBLIC_AI_ENABLED=true so the UI shows
# the feature. Leave the key unset to disable AI (the pantry matcher still works).
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8; e.g. claude-haiku-4-5 for cheaper/faster).
ANTHROPIC_MODEL=claude-opus-4-8
NEXT_PUBLIC_AI_ENABLED=false

# ---- Rate limiting (Upstash Redis) — optional ----
# When unset, rate limiting is a no-op (allows all). Set both to enforce limits
# on auth, AI, writes — no code change required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
